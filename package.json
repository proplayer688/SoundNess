{
  "name": "friends-sound-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "friendsdk dev ./games/lofi-beat-lab",
    "dev:lan": "friendsdk dev ./games/lofi-beat-lab --host 0.0.0.0 --port 4173",
    "build:studio": "friendsdk build ./games/lofi-beat-lab",
    "check:studio": "friendsdk check ./games/lofi-beat-lab",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rarefriends/friendsdk": "https://github.com/spokesz/friendsdk/releases/download/v0.1.2/rarefriends-friendsdk-0.1.2.tgz",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^6.0.3"
  }
}
